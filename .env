# meta-llama/llama-4-scout-17b-16e-instruct "Visual Assessment"
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2048

HF_TOKEN=<YOUR_HF_TOKEN_HERE>

NEO4J_URI=neo4j+s://43b30b0c.databases.neo4j.io
NEO4J_USER=43b30b0c
NEO4J_PASSWORD=<YOUR_NEO4J_PASSWORD_HERE>
NEO4J_DATABASE=neo4j

# ── MMCOWS Model Paths ──────────────────────────────────────────────────
MMCOWS_BASE_PATH=C:/Users/Dell/.gemini/antigravity/scratch/veterinary_ai_system
MMCOWS_SRC_PATH=C:/Users/Dell/.gemini/antigravity/scratch/veterinary_ai_system
MMCOWS_SAVED_MODELS_DIR=C:/Users/Dell/.gemini/antigravity/scratch/veterinary_ai_system/saved_models

IDENTIFICATION_MODEL_NAME=Idintification model.pt
MILK_PREDICTION_MODEL_NAME=ensemble_TabTransformer_fold3.pth
BEHAVIOR_MODEL_NAME=heat_stress_model.pt
ANOMALY_MODEL_NAME=anomaly_autoencoder.pth
DISEASE_MODEL_NAME=best_model.pth
FUSION_MODEL_NAME=fusion_model.pth
HEALTH_MODEL_NAME=best_health_model.pt
HEALTH_SCALER_NAME=health_scaler.pkl

# ── MMCOWS Data Paths ───────────────────────────────────────────────────
MMCOWS_THI_DATA_PATH=./preprocessing_results/thi_station_avg.csv
MMCOWS_MERGED_DATA_PATH=./preprocessing_results/merged_multimodal_T01_0721.csv
MMCOWS_MILK_DATA_PATH=./preprocessing_results/milk_all_clean.csv

# ── Local Data Paths ────────────────────────────────────────────────────
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma_vet_rag
KB_CACHE_PATH=./data/pubmed_kb.json

# ── Identity System ─────────────────────────────────────────────────────
IDENTITY_CONFIDENCE_THRESHOLD=0.85

# ── RAG ──────────────────────────────────────────────────────────────────
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=650
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_MIN_RELEVANCE_SCORE=0.55

# ── Safety ───────────────────────────────────────────────────────────────
MIN_CONFIDENCE_FOR_AUTO_DIAGNOSIS=0.60
REQUIRE_WEIGHT_FOR_DOSING=true
BLOCK_UNCERTAIN_RECOMMENDATIONS=true

# ── Application ──────────────────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
API_VERSION=v1
LOG_LEVEL=INFO
ENABLE_DETAILED_LOGGING=false

ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
MAX_PARALLEL_WORKERS=4
