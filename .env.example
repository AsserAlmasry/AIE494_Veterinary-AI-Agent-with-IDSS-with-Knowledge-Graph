
# ============================================================
#  VETERINARY AI SYSTEM — Environment Configuration Template
#  Copy this file to .env and fill in your actual values
# ============================================================

# ── LLM (Groq) ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2048

# ── HuggingFace ─────────────────────────────────────────────
HF_TOKEN=your_hf_token_here

# ── Neo4j ───────────────────────────────────────────────────
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=your_neo4j_user
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ── Model Weights (Google Drive URLs) ───────────────────────
IDENTITY_MODEL_URL=https://drive.google.com/uc?id=1xY5WAqYsh1pEfaMbSNPgFQKt_7nq5WeC
DISEASE_MODEL_URL=https://drive.google.com/uc?id=1WEtfzuUFraiyPlcvRyQjW7aHpnkB8n45
EARLY_WARNING_MODEL_URL=https://drive.google.com/uc?id=1GUFj7xy8s3snXNUh47_-cDpPab-E3uTm

# ── Model Local Paths ────────────────────────────────────────
WEIGHTS_DIR=./weights
IDENTITY_MODEL_NAME=mmcows_yolo_identity.pt
DISEASE_MODEL_NAME=disease_classifier_maxvit.pt
EARLY_WARNING_MODEL_NAME=early_warning_healthrisk.pt

# ── Data & Storage ───────────────────────────────────────────
DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma_vet_rag
IDENTITY_BANK_PATH=./data/identity_bank.pkl
KB_CACHE_PATH=./data/pubmed_kb.json

# ── Identity System ──────────────────────────────────────────
IDENTITY_SIMILARITY_THRESHOLD=0.85
IDENTITY_EMBEDDING_DIM=512
MIN_EMBEDDINGS_PER_COW=3
MAX_EMBEDDINGS_PER_COW=20

# ── RAG System ───────────────────────────────────────────────
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=650
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_MIN_RELEVANCE_SCORE=0.7

# ── Safety & Clinical ────────────────────────────────────────
MIN_CONFIDENCE_FOR_AUTO_DIAGNOSIS=0.75
REQUIRE_WEIGHT_FOR_DOSING=true
BLOCK_UNCERTAIN_RECOMMENDATIONS=true

# ── Application ──────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
API_VERSION=v1
LOG_LEVEL=INFO
ENABLE_DETAILED_LOGGING=false

# ── Performance ──────────────────────────────────────────────
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
MAX_PARALLEL_WORKERS=4
STAGE1_TIMEOUT_MS=1000
